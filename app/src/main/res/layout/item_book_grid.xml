<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="4dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="175dp" android:background="#FFFFFF" android:padding="2dp">
        <ImageView android:id="@+id/ivBookCover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#F5F5F5" />
        <TextView android:id="@+id/tvBookProgress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="4dp" android:background="#FFFFFF" android:paddingHorizontal="8dp" android:paddingVertical="1dp" android:text="0%" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvBookFormat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="6dp" android:background="#FFFFFF" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="PDF" android:textColor="#000000" android:textSize="13sp" android:textStyle="bold" />
    </FrameLayout>
    <TextView android:id="@+id/tvBookTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:text="اسم الكتاب" android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
